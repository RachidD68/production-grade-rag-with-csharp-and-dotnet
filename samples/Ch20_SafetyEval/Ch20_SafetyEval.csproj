<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RagInDotNet.Samples.Ch20_SafetyEval</RootNamespace>
    <AssemblyName>Ch20_SafetyEval</AssemblyName>
    <!-- ContentHarmEvaluator / ProtectedMaterialEvaluator and their
         ContentSafetyServiceConfiguration surface are gated behind the
         AIEVAL001 experimental diagnostic. We reference them (build-verified)
         but only invoke them when a Foundry endpoint is configured. -->
    <NoWarn>$(NoWarn);AIEVAL001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Safety" />
    <!-- Azure.Search.Documents is already pinned by the repo and is referenced
         here only for its transitive Azure.Identity (DefaultAzureCredential) —
         the same way SmartDocs.Retrieval's Azure adapters obtain a credential.
         No new pin is introduced. The Foundry Safety path is build-verified and
         only executes when AZURE_AI_FOUNDRY_ENDPOINT is set. -->
    <PackageReference Include="Azure.Search.Documents" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartDocs.Core\SmartDocs.Core.csproj" />
    <ProjectReference Include="..\..\src\SmartDocs.Generation\SmartDocs.Generation.csproj" />
  </ItemGroup>

</Project>
