<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RagInDotNet.Samples.Ch21_AotMcpServer</RootNamespace>
    <AssemblyName>Ch21_AotMcpServer</AssemblyName>

    <!-- Ch 21 §2.9 — Native AOT. This is the publish-profile toggle the chapter
         shows. PublishAot is honoured by `dotnet publish`; a normal `dotnet
         build` ignores it, so the project always builds in the solution. We also
         turn on the AOT/trim analyzers so the same warnings AOT would surface
         appear at build time and we can see exactly what the MCP SDK + MEAI
         contribute. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier Condition="'$(PublishAot)' == 'true' and '$(_IsPublishing)' == 'true'">win-x64</RuntimeIdentifier>

    <!-- Trim analysis (PublishTrimmed) is clean on ModelContextProtocol 2.2.0 +
         Microsoft.Extensions.AI 10.9.0 (zero ILxxxx warnings, September 2026),
         but neither package promises full trim/AOT annotation, so a future
         `dotnet publish /p:PublishAot=true` may surface IL2104 / IL3053 from
         those assemblies. Treating them as errors here would make an honest
         AOT experiment break the build, so we down-grade AOT-analysis warnings
         to messages in THIS sample only. The build bar for
         the solution stays "0 warnings"; the AOT story is documented, not shipped
         as a clean native binary. See README.md. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
