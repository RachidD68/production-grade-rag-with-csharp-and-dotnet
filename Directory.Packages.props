<Project>

  <!--
    Central Package Management for the entire solution.

    Versions are pinned and verified against NuGet at the start of each phase.
    See docs/decisions/0005-version-drift-from-mission-brief.md for the
    May 2026 reconciliation between the mission brief's pins and the actual
    GA versions on NuGet at the time of writing.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework (MAF) — GA April 2026">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.3.0" />
    <!-- A2A is preview at time of writing — see ADR-0006. -->
    <PackageVersion Include="Microsoft.Agents.AI.A2A" Version="1.3.0-preview.260423.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.3.0-preview.260423.1" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.AI — unified IChatClient / IEmbeddingGenerator">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.5.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.5.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.1-preview.1.25264.1" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.VectorData — abstractions GA, connectors preview">
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.5.0" />
    <!-- Connectors are pinned in the projects that consume them (Phase 2, Ch 6). -->
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.* — hosting, configuration, DI, resilience">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.5.0" />
  </ItemGroup>

  <ItemGroup Label="Tokenizers, embeddings, local LLMs">
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="OllamaSharp" Version="5.4.25" />
  </ItemGroup>

  <ItemGroup Label="Vector and graph databases">
    <PackageVersion Include="Qdrant.Client" Version="1.17.0" />
    <PackageVersion Include="Neo4j.Driver" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Label="Resilience">
    <PackageVersion Include="Polly" Version="8.6.6" />
    <PackageVersion Include="Polly.Extensions" Version="8.6.6" />
  </ItemGroup>

  <ItemGroup Label="Observability — OpenTelemetry">
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.0" />
  </ItemGroup>

  <ItemGroup Label="Model Context Protocol (MCP)">
    <PackageVersion Include="ModelContextProtocol" Version="1.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Label="CLI tooling">
    <PackageVersion Include="System.CommandLine" Version="2.0.7" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Testcontainers" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.Qdrant" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.Neo4j" Version="4.11.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
