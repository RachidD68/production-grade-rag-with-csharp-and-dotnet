<Project>

  <!--
    Solution-wide MSBuild defaults.

    Every src/ project inherits these. Test projects override TreatWarningsAsErrors
    via Directory.Build.props in tests/ to allow xUnit analyzer false-positives if
    they appear after a package bump.
  -->

  <PropertyGroup Label="Target framework and language">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Quality bar">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs on public types — chapters introduce these incrementally. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Build determinism and reproducibility">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Rachid Dahir</Authors>
    <Company>Rachid Dahir</Company>
    <Product>RAG in .NET — Companion Code</Product>
    <Copyright>© 2026 Rachid Dahir</Copyright>
    <RepositoryUrl>https://github.com/rachiddahir/RAG-in-DotNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
