<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Query routing for the SmartDocs RAG stack: classifies an incoming query and dispatches it to the right retrieval strategy. A support package consumed by the MCP server and higher composition layers.</Description>
    <PackageTags>rag;routing;query-classification;ai;llm;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDocs.Core\SmartDocs.Core.csproj" />
    <ProjectReference Include="..\SmartDocs.Retrieval\SmartDocs.Retrieval.csproj" />
  </ItemGroup>

</Project>
